<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg">

    <!-- 内容容器：直接承载 WebView，不下滑刷新，避免误触 -->
    <FrameLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 核心 Web 控制器：渲染 Reasonix Studio -->
        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/brand_bg"
            android:overScrollMode="never" />

        <!-- 页面加载进度条 -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100"
            android:progressTint="@color/brand_gilt"
            android:visibility="gone" />

        <!-- 空状态：尚未连接设备引导 -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/brand_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_qr_scan"
                app:tint="@color/brand_gilt" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/empty_title"
                android:textColor="@color/brand_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/empty_desc"
                android:textColor="@color/brand_ink_dim"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_empty_scan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_button_gold"
                android:text="@string/btn_scan_connect"
                android:textColor="@color/brand_bg"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_qr_scan"
                app:iconGravity="textStart"
                app:iconTint="@color/brand_bg" />

        </LinearLayout>

        <!-- 错误状态：连接中断重试引导 -->
        <LinearLayout
            android:id="@+id/layout_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/brand_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_title"
                android:textColor="@color/brand_danger"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/brand_ink_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_retry"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_gold"
                    android:text="@string/btn_retry"
                    android:textColor="@color/brand_bg"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_error_scan"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/btn_rescan"
                    android:textColor="@color/brand_gilt"
                    app:strokeColor="@color/brand_gilt" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!--
        浮动操作悬浮按钮：支持随时点击调出菜单（重新扫码/刷新/断开）。
        默认停靠右侧垂直居中而非右下角 —— 右下角与电脑端页面的提示词发送按钮重叠。
        FloatingFabController 会在此基础上支持拖拽吸附、键盘弹出让位与静止半透明。
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_margin="12dp"
        android:contentDescription="@string/menu_device_options"
        android:src="@drawable/ic_menu"
        app:backgroundTint="@color/brand_gilt"
        app:fabSize="mini"
        app:tint="@color/brand_bg" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
